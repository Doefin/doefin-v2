{
  "name": "@doefin/doefin-v2",
  "version": "2.0.0",
  "description": "Decentralized Bitcoin prediction markets on Ethereum using Diamond Standard (EIP-2535) and Conditional Token Framework.",
  "main": "index.js",
  "scripts": {
    "test": "npx hardhat test",
    "test:unit": "npx hardhat test test/unit/",
    "test:integration": "npx hardhat test test/integration/",
    "test:coverage": "npx hardhat coverage",
    "compile": "npx hardhat compile",
    "deploy:local": "npx hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "npx hardhat run scripts/deploy.js --network arbitrumSepolia",
    "node": "npx hardhat node",
    "clean": "npx hardhat clean",
    "size": "npx hardhat compile && npx hardhat size-contracts",
    "gas-report": "REPORT_GAS=true npx hardhat test",
    "lint": "solhint 'contracts/**/*.sol'",
    "format": "prettier --write 'contracts/**/*.sol' 'test/**/*.js' 'scripts/**/*.js'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/predexyo/doefin-v2.git"
  },
  "author": "Doefin Team",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/predexyo/doefin-v2/issues"
  },
  "homepage": "https://github.com/predexyo/doefin-v2#readme",
  "devDependencies": {
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@nomiclabs/hardhat-waffle": "^2.0.1",
    "chai": "^4.3.4",
    "dotenv": "^8.6.0",
    "ethereum-waffle": "^3.4.0",
    "ethers": "^5.8.0",
    "hardhat": "^2.25.0",
    "mocha": "^11.7.1",
    "prettier": "^2.3.2",
    "prettier-plugin-solidity": "^1.0.0-beta.13",
    "standard": "^16.0.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.3.0",
    "ffjavascript": "^0.3.1",
    "web3": "^4.16.0"
  }
}
