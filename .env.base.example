# Base mainnet — Safe-owned Diamond deployment
# ⚠️  REAL MONEY. Only run after the Sepolia rehearsal is fully green.
# Copy values into your .env (gitignored), then:  npm run deploy:safe:base

# ─── Network ────────────────────────────────────────────────────────────────
BASE_MAINNET_RPC_ENDPOINT=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
ETHERSCAN_API_KEY=                       # Multichain Etherscan v2 key

# ─── Deployer EOA (must be a signer on SAFE_ADDRESS) ───────────────────────
# Recommend a hardware wallet or dedicated deploy key, not a daily-driver wallet.
PRIVATE_KEY=0x...

# ─── Safe multi-sig that will own the Diamond ──────────────────────────────
# Your production Safe on Base mainnet (chain 8453).
SAFE_ADDRESS=0x...

# ─── Match-engine operator (fresh hot wallet — NOT a personal wallet) ──────
OPERATOR_ADDRESS=0x...

# ─── Collateral token: real USDC on Base mainnet (6 decimals) ──────────────
COLLATERAL_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
COLLATERAL_TOKEN_DECIMALS=6

# ─── Optional ──────────────────────────────────────────────────────────────
# FEE_RECEIVER_ADDRESS=                  # defaults to SAFE_ADDRESS
# START_PAUSED=true                      # keep "true" for mainnet — unpause via Safe after backend cutover
# SKIP_VERIFY=false
