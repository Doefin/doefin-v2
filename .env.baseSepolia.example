# Base Sepolia — Safe-owned Diamond deployment
# Copy values into your .env (gitignored), then:
#   npm run deploy:safe:baseSepolia

# ─── Network ────────────────────────────────────────────────────────────────
BASE_SEPOLIA_RPC_ENDPOINT=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
ETHERSCAN_API_KEY=                       # Multichain Etherscan v2 key

# ─── Deployer EOA (must be a signer on SAFE_ADDRESS) ───────────────────────
PRIVATE_KEY=0x...

# ─── Safe multi-sig that will own the Diamond ──────────────────────────────
# Create at https://app.safe.global on Base Sepolia. For the first run,
# use 1-of-1 with PRIVATE_KEY as the sole signer to validate the SDK flow.
SAFE_ADDRESS=0x...

# ─── Match-engine operator (NOT the Safe — must be an EOA hot wallet) ──────
OPERATOR_ADDRESS=0x...

# ─── Collateral tokens to whitelist on the new Diamond ────────────────────
# Comma-separated lists. Both lists must have the same length and the
# decimals must be in the same order as the addresses.
# Default below: mock USDT (6 decimals) + mock WBTC (8 decimals), both already
# referenced by the backend (.env: MUSDT_TOKEN_ADDRESS / MWBTC_TOKEN_ADDRESS).
COLLATERAL_TOKEN_ADDRESS=0x290F9Aa4641E58A5E098e8860161Ab6B5df5C557,0x41f8d70aC28C340c5D3038FB987ab2CC985b13A9
COLLATERAL_TOKEN_DECIMALS=6,8

# ─── Optional ──────────────────────────────────────────────────────────────
# FEE_RECEIVER_ADDRESS=                  # defaults to SAFE_ADDRESS
# START_PAUSED=true                      # set "false" to unpause at deploy
# SKIP_VERIFY=false                      # set "true" to skip Basescan verify
# MAX_FEE_RATE_BPS=100                   # integer in [0, 1000]; if unset the
#                                        # chain default (0) leaves the contract
#                                        # fail-closed and the first operator
#                                        # fee reverts FeeExceedsMaxRate
